---
// src/components/Versiculo.astro
// Banda vino con el versículo bíblico.
// ── DATOS EDITABLES ───────────────────────────────────────────
const versiculo = [
    "TRES COSAS DURARÁN PARA SIEMPRE:",
    "LA FE, LA ESPERANZA Y EL AMOR.",
    "PERO LA MAYOR DE TODAS ES EL AMOR.",
];
const cita = "1 Corintios 13:13";
// ──────────────────────────────────────────────────────────────
---

<section
    id="versiculo"
    class="franja relative w-full py-10 px-4 overflow-hidden"
>
    <!-- Los filetes van dentro del fondo para entrar junto con la banda -->
    <div class="franja-fondo absolute inset-0">
        <span class="franja-filete arriba"></span>
        <span class="franja-filete abajo"></span>
    </div>

    <p
        class="franja-texto relative font-callingstone text-tinta text-center text-[clamp(0.6rem,3.05vw,0.83rem)] tracking-[0.05em] leading-[2.4]"
    >
        {versiculo.map((linea) => <span class="block whitespace-nowrap">{linea}</span>)}
    </p>

    <div class="franja-texto relative mt-5" aria-hidden="true">
        <div class="adorno-crema">
            <span></span><i></i><span></span>
        </div>
    </div>

    <p
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.8rem,3.6vw,1rem)] tracking-[0.08em] mt-4"
    >
        {cita}
    </p>
</section>


<script>
    import { animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("versiculo");
        if (seccion) animarFranja(seccion);
    });
</script>
