---
// src/components/Padrinos.astro
// Banda "Nuestros padrinos" + los padrinos de cada ceremonia, unidos por
// un "&" dorado como los padres. Misma entrada que el resto de las
// secciones claras: la banda con su brillo y los renglones uno tras otro.
// ── DATOS EDITABLES ───────────────────────────────────────────
import FloresEsquinas from "./FloresEsquinas.astro";
const titulo = "NUESTROS PADRINOS";

const padrinos = [
    {
        titulo: "PADRINOS DE RELIGIOSO",
        nombres: ["David Condori Cóndori", "Elizabeth Yujra de Cóndori"],
    },
    {
        titulo: "PADRINOS DE CIVIL",
        nombres: ["Ladislao Flavio Calle Mamani", "Wendy Condori de Calle"],
    },
];
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-padrinos"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0">
        <span class="franja-filete arriba"></span>
        <span class="franja-filete abajo"></span>
    </div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="padrinos" class="relative isolate overflow-hidden w-full px-5 pt-14 pb-24 text-center">
    {
        padrinos.map((grupo, i) => (
            <div class={i > 0 ? "mt-9" : ""}>
                {i > 0 && (
                    <div class="adorno-oro mb-9" aria-hidden="true">
                        <span /><i /><span />
                    </div>
                )}
                <h3 class="font-callingstone text-oro-hondo text-[clamp(0.6rem,3.05vw,0.83rem)] tracking-[0.14em] whitespace-nowrap">
                    {grupo.titulo}
                </h3>
                <div class="mt-3">
                    {grupo.nombres.map((nombre, j) => (
                        <>
                            {j > 0 && (
                                <p
                                    class="font-great-vibes text-oro-hondo text-[2rem] leading-[1.1]"
                                    aria-hidden="true"
                                >
                                    &amp;
                                </p>
                            )}
                            <p class="font-cormorant font-semibold text-marron text-[clamp(1.2rem,5.6vw,1.45rem)] leading-[1.35] whitespace-nowrap">
                                {nombre}
                            </p>
                        </>
                    ))}
                </div>
            </div>
        ))
    }

    <div class="adorno-vino mt-10" aria-hidden="true">
        <span></span><i></i><span></span>
    </div>

    <FloresEsquinas lados={["der"]} ancho={120} />
</section>

<script>
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-padrinos");
        if (franja) animarFranja(franja);

        const seccion = document.getElementById("padrinos");
        if (seccion) animarEntrada(seccion.children, seccion);
    });
</script>
